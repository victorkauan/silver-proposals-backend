ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://silver:silver@localhost:5432/silver_proposals
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Base64 of 32 random bytes (AES-256): python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
TOTP_ENCRYPTION_KEY=
CORS_ORIGINS=["http://localhost:5173"]
AI_PROVIDER=fake
# Pause between words of the fake stream, to watch the UI while it writes (0 to 1000).
FAKE_PROVIDER_DELAY_MS=0
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# AI_PROVIDER=deepinfra calls DeepInfra; it needs an API key.
DEEPINFRA_API_KEY=
